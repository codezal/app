        "maxDepth": {
          "default": 1,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maxWallClockMs": {
          "default": 1800000,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "isolation": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "none",
            "worktree"
          ]
        },
        "mergePolicy": {
          "default": "safe-auto",
          "type": "string",
          "enum": [
            "safe-auto",
            "manual"
          ]
        },
