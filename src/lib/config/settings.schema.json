      "default": {
        "enabled": false,
        "routing": "hybrid",
        "autoDelegate": true,
        "autoReview": false,
        "maxParallelRuns": 3,
        "maxChildRunsPerTurn": 5,
        "maxDepth": 1,
        "maxWallClockMs": 1800000,
        "isolation": "auto",
        "mergePolicy": "safe-auto",
        "roles": {}
