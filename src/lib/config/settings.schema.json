      "type": "number"
    },
    "apiKeys": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "defaultProvider": {
      "default": "openai",
      "type": "string"
    },
    "defaultModel": {
      "default": "gpt-5.4-mini",
      "type": "string"
    },
    "theme": {
      "default": "system",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ]
    },
    "fontScale": {
      "default": "m",
      "type": "string",
      "enum": [
        "s",
        "m",
        "l",
        "xl"
      ]
    },
    "language": {
      "default": "en",
      "type": "string"
    },
    "defaultWorkspacePath": {
      "type": "string"
    },
    "defaultAgent": {
      "type": "string"
    },
    "bashTimeoutMs": {
      "type": "number"
    },
